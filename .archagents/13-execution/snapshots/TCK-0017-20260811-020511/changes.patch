diff --git a/third_party/foundationmodels-swift/Package.swift b/third_party/foundationmodels-swift/Package.swift
new file mode 100644
index 0000000..fa875c6
--- /dev/null
+++ b/third_party/foundationmodels-swift/Package.swift
@@ -0,0 +1,74 @@
+// swift-tools-version: 6.0
+import PackageDescription
+import Foundation
+
+/// Distribution umbrella for Flutter `foundationmodels_apple` (TCK-0015).
+///
+/// Requires `FOUNDATIONMODELS_SWIFT_PATH` pointing at monorepo `swift/`.
+/// Products keep module names `FoundationModelsCore` / `FoundationModelsIOSBridge`
+/// by depending on the monorepo packages and re-exporting through thin targets
+/// that use the **same** module names via `swiftSettings: [.unsafeFlags]` —
+/// not available. Instead we set `path` products by making this package a
+/// **workspace root** that only lists dependencies — consumers should depend
+/// on the monorepo packages **or** set the env var used by the Flutter plugin.
+///
+/// This package's value for TCK-0015:
+/// 1. Single install contract documented here.
+/// 2. `swift package describe` succeeds when env is set (graph resolves).
+/// 3. Export targets compile against monorepo products.
+
+func monorepoSwiftRoot() -> String {
+  if let env = ProcessInfo.processInfo.environment["FOUNDATIONMODELS_SWIFT_PATH"], !env.isEmpty {
+    return env
+  }
+  // Sibling layout: <workspace>/aredes/estudos/foundationmodels-dart
+  //              +  <workspace>/ai-workflow/foundationmodels-js/swift
+  let file = URL(fileURLWithPath: #filePath)
+  let repoRoot = file.deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+  let candidate = repoRoot
+    .deletingLastPathComponent() // estudos
+    .appendingPathComponent("ai-workflow/foundationmodels-js/swift")
+    .path
+  if FileManager.default.fileExists(atPath: candidate + "/Package.swift")
+      || FileManager.default.fileExists(atPath: candidate + "/FoundationModelsCore/Package.swift") {
+    return candidate
+  }
+  fatalError(
+    "Set FOUNDATIONMODELS_SWIFT_PATH to foundationmodels-js/swift before resolving foundationmodels-swift"
+  )
+}
+
+let root = monorepoSwiftRoot()
+
+let package = Package(
+  name: "foundationmodels-swift",
+  platforms: [.iOS("27.0"), .macOS("27.0")],
+  products: [
+    .library(name: "FoundationModelsCore", targets: ["FMCoreShim"]),
+    .library(name: "FoundationModelsIOSBridge", targets: ["FMIOSBridgeShim"]),
+  ],
+  dependencies: [
+    .package(path: root + "/FoundationModelsCore"),
+    .package(path: root + "/ios-bridge"),
+  ],
+  targets: [
+    // Shim targets re-export monorepo modules. Import name is FMCoreShim /
+    // FMIOSBridgeShim — the Flutter plugin continues to use monorepo path
+    // deps (FOUNDATIONMODELS_SWIFT_PATH) for correct module names. These
+    // products exist so `package: foundationmodels-swift` resolves a full graph.
+    .target(
+      name: "FMCoreShim",
+      dependencies: [
+        .product(name: "FoundationModelsCore", package: "FoundationModelsCore"),
+      ],
+      path: "Sources/FMCoreShim"
+    ),
+    .target(
+      name: "FMIOSBridgeShim",
+      dependencies: [
+        .product(name: "FoundationModelsIOSBridge", package: "ios-bridge"),
+      ],
+      path: "Sources/FMIOSBridgeShim"
+    ),
+  ]
+)
diff --git a/third_party/foundationmodels-swift/README.md b/third_party/foundationmodels-swift/README.md
new file mode 100644
index 0000000..8c5a46d
--- /dev/null
+++ b/third_party/foundationmodels-swift/README.md
@@ -0,0 +1,33 @@
+# foundationmodels-swift (TCK-0015)
+
+Umbrella package that resolves `FoundationModelsCore` + `FoundationModelsIOSBridge`
+from a local [foundationmodels-js](https://github.com/cristianoaredes/foundationmodels-js)
+checkout.
+
+## Required env
+
+```bash
+export FOUNDATIONMODELS_SWIFT_PATH=/path/to/foundationmodels-js/swift
+```
+
+## Flutter plugin (recommended)
+
+The Flutter plugin `Package.swift` already consumes the monorepo layout
+directly when `FOUNDATIONMODELS_SWIFT_PATH` is set (correct module names
+`FoundationModelsCore` / `FoundationModelsIOSBridge`). Prefer that path for
+app builds.
+
+## Validate this umbrella
+
+```bash
+export FOUNDATIONMODELS_SWIFT_PATH=.../foundationmodels-js/swift
+cd third_party/foundationmodels-swift
+swift package describe
+swift build  # builds shims + monorepo deps
+```
+
+## Publishing to GitHub
