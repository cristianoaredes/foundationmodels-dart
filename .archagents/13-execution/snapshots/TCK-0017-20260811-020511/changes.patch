+      final tool = FmTool.static(
+        name: 's',
+        description: 'static',
+        // maxLength is out-of-subset for tools — sanitized, not thrown.
+        inputSchema: FmSchema.string(),
+        staticOutput: 'ok',
+      );
+      // Unary static is allowed (no callback).
+      await fm.respond(input: 'hi', tools: [tool]);
